GEMINI_API_KEY=ضع_المفتاح_الجديد_هنا
# Use an exact supported Gemini model. gemini-flash-latest is also a valid alias.
GEMINI_MODEL=gemini-flash-latest
JWT_SECRET=غيّر_هذا_إلى_قيمة_عشوائية_طويلة
FREE_PAGES_PER_DAY=3
MAX_FILE_MB=4
MAX_PAGES_PER_JOB=30
# Vercel Storage -> Upstash Redis supplies these two values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
